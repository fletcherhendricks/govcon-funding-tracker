# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard > Project Settings > API Keys (and Data API for the URL).
# Both values are safe to expose to the browser. Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
